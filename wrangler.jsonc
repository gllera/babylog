{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baby-feeding-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // Two hostnames, two auth gates: baby.llera.eu is fronted by Cloudflare
  // Access, baby.32b.io runs the OIDC code+PKCE flow against auth.32b.io and
  // mints its own `__Host-bsess` cookie (src/oidc.ts, src/session.ts). Both are
  // attached as Worker *custom domains* out of
  // band (see docs/setup.md) rather than declared here — the CI token is
  // account-scoped (Workers Scripts + D1) and cannot touch zone routes.
  // Keep the *.workers.dev origin disabled: no Access in front of it, and the
  // registered redirect_uri names baby.32b.io exactly, so a login started on a
  // workers.dev origin is refused by the IdP rather than half-working — leaving
  // it on would just be a third, weaker door. Pinned here so a deploy can't
  // silently re-enable it.
  "workers_dev": false,

  // Import .html files as plain strings (the web app shell in src/app.html).
  "rules": [{ "type": "Text", "globs": ["**/*.html"] }],

  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "BabyFeedingMCP"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BabyFeedingMCP"]
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "baby-feedings",
      "database_id": "41671b7b-2efa-439c-b650-9d6f2bc670db",
      "migrations_dir": "migrations"
    }
  ],

  // Cloudflare Access (Managed OAuth) fronts /mcp and runs the OAuth flow.
  // The Worker verifies the Access JWT it forwards: signed by this team and
  // scoped to the `baby-mcp` Access app's AUD tag. Neither value is secret.
  "vars": {
    "TEAM_DOMAIN": "https://llera.cloudflareaccess.com",
    "POLICY_AUD": "46469599b9997439c39c5a7b85f78c42cab415ab09e6ae87ff39636d632da5d2",

    // --- OIDC client registration at auth.32b.io ----------------------------
    //
    // These two replaced SESSION_PUBLIC_JWK, which held auth.32b.io's Ed25519
    // public key so this Worker could verify the estate's shared `sess` cookie.
    // It is gone along with the verifier: babylog exchanges an authorization
    // code and mints its own session now, and the whole reason to do that was to
    // stop reading a cookie scoped Domain=32b.io. See src/session.ts.
    //
    // The pinned key went with it, and good riddance — a client holding its own
    // copy of the signing key is exactly what cannot notice a rotation. Keys now
    // come from the IdP's published jwks_uri, read out of the discovery document
    // beneath the issuer below, on every cold isolate.
    //
    // Both must live in THIS FILE rather than the dashboard: `wrangler deploy`
    // uploads these vars over whatever the dashboard holds, so a dashboard-only
    // value would vanish on the next deploy and take every login with it.
    //
    // The tenant segment is load-bearing: `32b` is the estate's own tenant (id
    // `t_32b` until auth's migration 0010 renamed it, 2026-08-09),
    // whose subject_type is `public` — so `sub` in an id_token is the same
    // `u_<ULID>` account id the shared cookie used to carry, and no data in this
    // repo had to move. A pairwise tenant would have handed us different
    // subjects for the same people.
    "OIDC_ISSUER": "https://auth.32b.io/t/32b",
    "OIDC_CLIENT_ID": "babylog",

    // --- Alexa account linking (src/alexa-link.ts) --------------------------
    //
    // The mini authorization server babylog fronts for Amazon's Alexa
    // account-linking client. Non-secret halves live here for the same reason
    // as the OIDC pair above: `wrangler deploy` overwrites dashboard vars.
    //
    // ALEXA_LINK_REDIRECTS is the exact-match allowlist of Amazon's linking
    // redirect URLs; the trailing segment is this Amazon vendor id
    // (MJH478DMH786M). ALEXA_LINK_CLIENT_ID is what Amazon sends to /authorize
    // and /token; it must match the client id configured in the skill's
    // Account Linking settings (see alexa-skill/README.md).
    "ALEXA_LINK_CLIENT_ID": "alexa",
    "ALEXA_LINK_REDIRECTS": "https://pitangui.amazon.com/api/skill/link/MJH478DMH786M,https://layla.amazon.com/api/skill/link/MJH478DMH786M,https://alexa.amazon.co.jp/api/skill/link/MJH478DMH786M"

    // Not here, deliberately, and set with `wrangler secret put`:
    //   OIDC_CLIENT_SECRET — authenticates this Worker at auth.32b.io's /token.
    //   SESSION_HMAC_SECRET — HMAC key for babylog's own web session cookie.
    //   ALEXA_OAUTH_HMAC_SECRET — signs babylog's Alexa link tokens (distinct
    //     from the web session key: rotating one must not disturb the other).
    //   ALEXA_LINK_CLIENT_SECRET — the secret Amazon presents at /token; must
    //     match the skill's Account Linking config.
    // All can mint, which is the whole difference from the vars they sit beside.
  },

  "observability": {
    "enabled": true
  }
}
