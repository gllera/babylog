{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baby-feeding-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // Two hostnames, two auth gates: baby.llera.eu is fronted by Cloudflare
  // Access, baby.32b.io verifies the shared 32b.io `sess` cookie in-Worker
  // (Ed25519, against SESSION_PUBLIC_JWK). Both are attached as Worker
  // *custom domains* out of
  // band (see docs/setup.md) rather than declared here — the CI token is
  // account-scoped (Workers Scripts + D1) and cannot touch zone routes.
  // Keep the *.workers.dev origin disabled: no Access in front of it, and the
  // sess cookie is Domain=32b.io so it never reaches a workers.dev origin —
  // leaving it on would just be a third, weaker door. Pinned here so a deploy
  // can't silently re-enable it.
  "workers_dev": false,

  // Import .html files as plain strings (the web app shell in src/app.html).
  "rules": [{ "type": "Text", "globs": ["**/*.html"] }],

  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "BabyFeedingMCP"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BabyFeedingMCP"]
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "baby-feedings",
      "database_id": "41671b7b-2efa-439c-b650-9d6f2bc670db",
      "migrations_dir": "migrations"
    }
  ],

  // Cloudflare Access (Managed OAuth) fronts /mcp and runs the OAuth flow.
  // The Worker verifies the Access JWT it forwards: signed by this team and
  // scoped to the `baby-mcp` Access app's AUD tag. Neither value is secret.
  "vars": {
    "TEAM_DOMAIN": "https://llera.cloudflareaccess.com",
    "POLICY_AUD": "46469599b9997439c39c5a7b85f78c42cab415ab09e6ae87ff39636d632da5d2",

    // Who must have signed a `sess` cookie for this Worker to trust it.
    "ISSUER": "https://auth.32b.io",

    // auth.32b.io's public session key — filled in at the phase 1 cutover,
    // 2026-07-31. Verify only: it can never mint, which is why it is a var and
    // not a secret.
    //
    // It must live in THIS FILE and not the dashboard: `wrangler deploy` uploads
    // these vars over whatever the dashboard holds, so a dashboard-only value
    // would vanish on the next deploy and take every session with it.
    //
    // With the legacy HMAC branch gone there is nothing behind this: if it is
    // wrong or missing, baby.32b.io admits nobody (baby.llera.eu is unaffected —
    // Cloudflare Access fronts it). src/session.ts logs its absence by name so
    // that failure does not read as a mysterious estate-wide sign-out.
    //
    // Identical to 32b-auth's own SESSION_PUBLIC_JWK var and to the single key at
    // https://auth.32b.io/.well-known/jwks.json minus its kid/alg/use members.
    // Thumbprint: S2HM3LyPSCyr6Sb1_IwtgAHxeU5UC0KG7o7lPG5xPaY
    //
    // Note for a future rotation: pubKey() in src/session.ts does a single
    // JSON.parse, so this holds ONE key. 32b-auth's consumer/session.js accepts a
    // newline-separated list; this does not, so a rotation overlap needs a code
    // change here first.
    "SESSION_PUBLIC_JWK": "{\"crv\":\"Ed25519\",\"kty\":\"OKP\",\"x\":\"mALwZTbphxuOljph1tnRzXmzXZHps1zImCn9mObtpro\"}"
  },

  "observability": {
    "enabled": true
  }
}
